    "保留 PDF 页面布局；要单独调整字号，请切换正文阅读。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PDF page layout is preserved; switch to reflowed text to adjust the font size independently."
          }
