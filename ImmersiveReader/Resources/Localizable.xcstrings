    "20 分钟前读过": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read 20 minutes ago"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "20 分钟前读过"
          }
        }
      }
    },
    "DOCX 内容损坏，或包含当前转换器无法处理的结构。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DOCX is corrupted or contains structures the current converter cannot process."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DOCX 内容损坏，或包含当前转换器无法处理的结构。"
          }
        }
      }
    },
    "DOCX 尚未转换": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DOCX has not been converted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DOCX 尚未转换"
          }
        }
      }
    },
    "DOCX 正文无法完成安全清洗。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DOCX body text could not be sanitized safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DOCX 正文无法完成安全清洗。"
          }
        }
      }
    },
    "DOCX 没有可显示的正文。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DOCX has no displayable body text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DOCX 没有可显示的正文。"
          }
        }
      }
    },
    "DOCX 超过 %lld MB 的设备端转换限制。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DOCX exceeds the device conversion limit of %lld MB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DOCX 超过 %lld MB 的设备端转换限制。"
          }
        }
      }
    },
    "DOCX 转换器返回了无法识别的结果。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DOCX converter returned an unrecognized result."
