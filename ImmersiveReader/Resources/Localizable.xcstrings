{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "\n另有 %lld 个文档未能导入。": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\nOne more document could not be imported."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\n%lld more documents could not be imported."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "\n另有 %lld 个文档未能导入。"
                }
              }
            }
          }
        }
      }
    },
    "%@%@，%@，%@，%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$@, %3$@, %4$@, %5$@"
          }
        }
      }
    },
    "%@%@，%@，已读 %@，%@": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$@, %3$@, read %4$@, %5$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@，%@，已读 %@，%@"
          }
        }
      }
    },
    "%@导入": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported %@"
          }
        }
      }
    },
    "%@读过": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read %@"
          }
        }
      }
    },
    "%lld": {},
