        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 PDF 页面布局；要单独调整字号，请切换正文阅读。"
          }
        }
      }
    },
    "保留文字强调色，可直接调字号；图片和扫描内容不做 OCR，请查看原版。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
